rules_version = '2';

// La base n'est ouverte qu'aux appareils passés par l'application,
// qui ouvre une session anonyme à son démarrage. Un visiteur qui
// trouverait l'adresse du projet ne peut ni lire ni écrire.
service cloud.firestore {
  match /databases/{database}/documents {
    match /acces/{doc}   { allow read, write: if request.auth != null; }
    match /produits/{doc} { allow read, write: if request.auth != null; }
    match /jours/{doc}    { allow read, write: if request.auth != null; }
    match /{document=**}  { allow read, write: if false; }
  }
}
