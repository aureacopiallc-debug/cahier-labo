rules_version = '2';

// Accès limité aux trois collections de l'application. Tout le reste de
// la base est fermé, et la forme des documents est vérifiée à l'écriture :
// un appel qui ne ressemble pas à une saisie du Cahier est rejeté.
service cloud.firestore {
  match /databases/{database}/documents {

    match /acces/{personne} {
      allow read;
      allow write: if request.resource == null
        || (request.resource.data.keys().hasOnly(['nom','code','role','ordre'])
            && request.resource.data.nom is string
            && request.resource.data.nom.size() <= 60);
    }

    match /produits/{reference} {
      allow read;
      allow write: if request.resource == null
        || (request.resource.data.keys().hasOnly(['nom','seuil','ordre','type','base'])
            && request.resource.data.nom is string
            && request.resource.data.nom.size() <= 80
            && request.resource.data.seuil is number
            && request.resource.data.seuil >= 0
            && request.resource.data.seuil <= 10000);
    }

    match /jours/{date} {
      allow read;
      allow write: if request.resource == null
        || (request.resource.data.keys().hasOnly(['d','e'])
            && request.resource.data.d is string
            && request.resource.data.d.size() == 10);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
